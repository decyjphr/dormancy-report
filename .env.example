# GitHub personal access token (required)
# Needs permission to read org members, audit log, repos/issues/pulls, and Copilot seats.
GITHUB_TOKEN=your_github_token_here

# Optional defaults you may want to keep in your shell/scripts
# GITHUB_ORG=your_org_login
# GITHUB_ENTERPRISE=your_enterprise_slug
# DORMANCY_DAYS=30
