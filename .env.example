# ─── Authentication ────────────────────────────────────────────────────────────
# Option A: Personal access token (PAT)
# Needs: read:org, audit_log, repo, copilot
GITHUB_TOKEN=your_github_pat_here

# Option B: GitHub App credentials (preferred for automation)
# The app will exchange these for an installation access token automatically.
# Needs the same permissions as above granted to the App installation.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GITHUB_APP_INSTALLATION_ID=   # optional, auto-detected from --org / --enterprise

# ─── Optional defaults ─────────────────────────────────────────────────────────
# GITHUB_ORG=your_org_login
# GITHUB_ENTERPRISE=your_enterprise_slug
# DORMANCY_DAYS=30
